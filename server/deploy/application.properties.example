# TMS API settings for this server. Keep this file private: it holds the database password and
# the token secret. Read at startup from config/ next to tms-api.jar; restart the API after a change.
spring.profiles.active=prod
server.port=8980

# MySQL 8 database. Sessions run in UTC (the API relies on it); allowPublicKeyRetrieval is needed
# for MySQL 8 password logins without SSL.
spring.datasource.url=jdbc:mysql://DB_HOST:3306/tms?useSSL=false&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
spring.datasource.username=DB_USER
spring.datasource.password=DB_PASSWORD

# Signs the apps' login tokens. Random, at least 32 characters. Changing it signs everyone out.
tms.security.jwt-secret=JWT_SECRET

# The web console is served at http://<server>:8980/console/
tms.web-console.dir=web-console
# Uploaded files (tenant documents, maintenance photos). Back this folder up with the database.
tms.storage.dir=data/files
logging.file.name=logs/tms-api.log
# INFO normally; DEBUG temporarily to investigate a problem.
logging.level.com.revesoft.tms=INFO

# Swagger UI at /swagger-ui.html (off in production).
springdoc.api-docs.enabled=false
springdoc.swagger-ui.enabled=false
